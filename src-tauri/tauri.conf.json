{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Config Sync",
  "version": "0.0.1",
  "identifier": "dev.agentconfigsync.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Config Sync",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "publisher": "Agent Config Sync",
    "copyright": "Copyright © 2026 whispering233",
    "licenseFile": "../LICENSE",
    "shortDescription": "Pi CLI 配置同步桌面工具",
    "longDescription": "Agent Config Sync 把 Pi CLI 的受管配置导出为可跨机同步的快照，并在另一台机器上按快照落地。快照以文件为准，覆盖前先备份，删除逐项确认；密钥只保留宿主原生引用，auth.json 永不进入快照。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
